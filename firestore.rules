rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myTeam() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    function canReadOrWrite(data) {
      return signedIn() && (
        data.ownerUid == request.auth.uid ||
        (data.teamId != null && myTeam() != null && data.teamId == myTeam())
      );
    }

    match /users/{uid} {
      allow create: if signedIn() && uid == request.auth.uid;
      allow read: if signedIn() && uid == request.auth.uid;
      allow update: if signedIn() && uid == request.auth.uid;
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{collection}/{docId} {
      allow read: if canReadOrWrite(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (
          request.resource.data.teamId == null ||
          (myTeam() != null && request.resource.data.teamId == myTeam())
        );
      allow update: if canReadOrWrite(resource.data)
        && (
          request.resource.data.teamId == resource.data.teamId ||
          (request.resource.data.ownerUid == request.auth.uid && myTeam() != null && request.resource.data.teamId == myTeam())
        );
      allow delete: if false;
    }
  }
}
